<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-payments" author="RodionovM">

        <createTable tableName="payments">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="client_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="source_account_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="target_account_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="numeric(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="varchar(3)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)" defaultValue="CREATED">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_payments_client_status" tableName="payments">
            <column name="client_id"/>
            <column name="status"/>
        </createIndex>

        <createIndex indexName="idx_payments_status_updated" tableName="payments">
            <column name="status"/>
            <column name="updated_at"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>